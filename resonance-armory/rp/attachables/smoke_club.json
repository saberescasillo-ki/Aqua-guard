{
  "format_version": "1.10.0",
  "minecraft:attachable": {
    "description": {
      "identifier": "resonance:smoke_club",
      "materials": {
        "default": "entity_alphatest_glint",
        "enchanted": "entity_alphatest_glint"
      },
      "textures": {
        "default": "textures/models/smoke_club",
        "enchanted": "textures/misc/enchanted_item_glint"
      },
      "geometry": {
        "default": "geometry.smoke_club"
      },
      "render_controllers": [
        "controller.render.item_default"
      ],
      "animations": {
        "smoke_club.idle": "animation.smoke_club.idle"
      },
      "scripts": {
        "pre_animation": [
          "variable.smoke_club = (query.is_in_ui || (variable.is_paperdoll ?? 0)) ? 0 : query.is_item_name_any('slot.weapon.mainhand', 0, 'resonance:smoke_club');"
        ],
        "animate": [
          {
            "smoke_club.idle": "!c.is_first_person && (variable.smoke_club ?? 0)"
          }
        ],
        "initialize": [
          "variable.smoke_club = 0.0;"
        ]
      },
      "item": {
        "resonance:smoke_club": "(1.0)"
      }
    }
  }
}
