{
  "format_version": "1.10.0",
  "minecraft:attachable": {
    "description": {
      "identifier": "resonance:iron_halberd",
      "materials": {
        "default": "entity_alphatest_glint",
        "enchanted": "entity_alphatest_glint"
      },
      "textures": {
        "default": "textures/models/iron_halberd",
        "enchanted": "textures/misc/enchanted_item_glint"
      },
      "geometry": {
        "default": "geometry.iron_halberd"
      },
      "animations": {
        "iron_halberd.idle": "animation.iron_halberd.idle",
        "iron_halberd.run": "animation.iron_halberd.run",
        "iron_halberd.walk": "animation.iron_halberd.walk"
      },
      "scripts": {
        "pre_animation": [
          "variable.iron_halberd = (query.is_in_ui || v.is_paperdoll) ? 0 : query.is_item_name_any('slot.weapon.mainhand', 0, 'resonance:iron_halberd');"
        ],
        "animate": [
          {
            "iron_halberd.idle": "!c.is_first_person && variable.iron_halberd"
          },
          {
            "iron_halberd.run": "!c.is_first_person && variable.iron_halberd && q.is_moving"
          },
          {
            "iron_halberd.walk": "!c.is_first_person && variable.iron_halberd && q.is_sprinting"
          }
        ]
      },
      "render_controllers": ["controller.render.item_default"],
      "item": {
        "resonance:iron_halberd": "(1.0)"
      }
    }
  }
}
