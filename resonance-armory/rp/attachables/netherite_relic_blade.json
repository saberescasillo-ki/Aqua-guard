          "variable.netherite_relic_blade = (query.is_in_ui || (variable.is_paperdoll ?? 0)) ? 0 : query.is_item_name_any('slot.weapon.mainhand', 0, 'resonance:netherite_relic_blade');"
        ],
        "animate": [
          {
            "netherite_relic_blade.idle": "!c.is_first_person && (variable.netherite_relic_blade ?? 0)"
          }
        ],
        "initialize": [
          "variable.netherite_relic_blade = 0.0;"
        ]
      },
      "render_controllers": [
        "controller.render.item_default"
      ],
      "item": {
        "resonance:netherite_relic_blade": "(1.0)"
      }
    }
  }
