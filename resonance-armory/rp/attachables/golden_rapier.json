{
  "format_version": "1.10.0",
  "minecraft:attachable": {
    "description": {
      "identifier": "resonance:golden_rapier",
      "materials": {
        "default": "entity_alphatest_glint",
        "enchanted": "entity_alphatest_glint"
      },
      "textures": {
        "default": "textures/models/golden_rapier",
        "enchanted": "textures/misc/enchanted_item_glint"
      },
      "geometry": {
        "default": "geometry.golden_rapier"
      },
      "animations": {
        "smoke_club.idle": "animation.smoke_club.idle"
      },
      "scripts": {
        "pre_animation": [
          "variable.smoke_club = (query.is_in_ui || v.is_paperdoll) ? 0 : query.is_item_name_any('slot.weapon.mainhand', 0, 'resonance:smoke_club');"
        ],
        "animate": [
          {
            "smoke_club.idle": "!c.is_first_person && variable.smoke_club"
          }
        ]
      },
      "render_controllers": ["controller.render.item_default"],
      "item": {
        "resonance:golden_rapier": "(1.0)"
      }
    }
  }
}
